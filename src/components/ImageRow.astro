---
/**
 * Two or more <Figure>s side by side, scaled to the same height.
 * Stacks into a column on phones.
 *
 *   <ImageRow>
 *     <Figure src={front} alt="Front" caption="Front" />
 *     <Figure src={back} alt="Back" caption="Back" />
 *   </ImageRow>
 *
 * Available in every project and media post without importing it.
 */
---

<div class="img-row">
	<slot />
</div>
