---
/**
 * Media post card for justified rows (home "Recent Media", /media Recent).
 * Place inside `.photo-home-grid`: the card sets `--ar` so every card in a row
 * shares one height and keeps the cover's aspect ratio.
 */
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { kindLabels, resolveMediaCover } from '../utils/media-assets';
import Pin from './Pin.astro';

interface Props {
	post: CollectionEntry<'media'>;
}

const { post } = Astro.props;
const cover = resolveMediaCover(post);
const pinned = post.data.pin === true;
const date = post.data.pubDate
	? post.data.pubDate.toLocaleDateString('en-GB', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' })
	: '';
---

<a
	class:list={['photo-home-card', !cover && 'photo-home-card--no-cover']}
	href={`/media/${post.id}/`}
	style={`--ar: ${cover ? (cover.width / cover.height).toFixed(4) : '1.5'}`}
>
	{
		cover ? (
			<div class="photo-home-media">
				<Image
					src={cover}
					alt={`${post.data.title} — cover`}
					widths={[480, 800, 1200, 1600]}
					sizes="(max-width: 560px) 100vw, 45vw"
					loading="lazy"
				/>
				<div class="photo-home-overlay" aria-hidden="true" />
				<div class="p-arrow" aria-hidden="true">
					<svg width="14" height="14" viewBox="0 0 14 14" fill="none">
						<path
							d="M2 12L12 2M12 2H4M12 2V10"
							stroke="white"
							stroke-width="1.5"
							stroke-linecap="round"
							stroke-linejoin="round"
						/>
					</svg>
				</div>
			</div>
		) : null
	}
	<div class="photo-home-body">
		<h3 class="photo-home-title">
			{post.data.title}
			<Pin pinned={pinned} />
		</h3>
		<span class="photo-home-date">
			{kindLabels[post.data.kind]}
			{date ? ` · ${date}` : ''}
		</span>
	</div>
</a>
