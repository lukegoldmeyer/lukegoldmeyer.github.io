---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { site } from '../../site';
import { mediaKinds } from '../../utils/media-kinds';
import { kindLabels, resolveMediaCover } from '../../utils/media-assets';
import { entryIsPublic } from '../../utils/content-visibility';
import { sortProjectsByRecency } from '../../utils/sort-projects';
import MediaCard from '../../components/MediaCard.astro';

const all = sortProjectsByRecency(await getCollection('media', entryIsPublic));
/** `pin: true` lists under Featured only, not Recent; still in All. */
const recent = all.filter((p) => p.data.pin !== true).slice(0, 3);
const featured = all.filter((p) => p.data.pin === true).slice(0, 3);

/** Filter chips for kinds that have at least one post. */
const kindCounts = mediaKinds
	.map((kind) => ({ kind, label: kindLabels[kind], count: all.filter((p) => p.data.kind === kind).length }))
	.filter((k) => k.count > 0);
---

<BaseLayout title={`Media — ${site.name}`} description="Photography, graphic design, and video.">
	<header class="blog-hero">
		<p class="section-label">{site.mediaIntro}</p>
		<h1>Media</h1>
		<p>Photography, graphic design, and video.</p>
	</header>

	{
		all.length === 0 ? (
			<div class="photo-index">
				<p class="work-empty">
					No media posts yet. Add one from <a class="link-accent" href="/admin/">/admin</a>, or add a folder
					under <code class="work-empty-code">src/content/media/&lt;slug&gt;/</code> with{' '}
					<code class="work-empty-code">index.mdx</code> and its files beside it.
				</p>
			</div>
		) : (
			<>
				<section class="proj-duo proj-duo--photo-hub" aria-label="Recent and featured media" data-reveal>
					<div class="proj-duo-col">
						<h2 class="proj-duo-title">Recent</h2>
						{recent.length === 0 ? (
							<p class="proj-duo-empty">
								Nothing recent yet. Featured posts (<code class="work-empty-code">pin: true</code>) only show
								under Featured.
							</p>
						) : (
							<div class="proj-cards">
								{recent.map((post) => (
									<MediaCard post={post} />
								))}
							</div>
						)}
					</div>

					<div class="proj-duo-col">
						<h2 class="proj-duo-title">Featured</h2>
						{featured.length === 0 ? (
							<p class="proj-duo-empty">
								Nothing featured yet. Turn on <strong>Pin</strong> for a post in /admin to feature it here.
							</p>
						) : (
							<div class="proj-cards">
								{featured.map((post) => (
									<MediaCard post={post} />
								))}
							</div>
						)}
					</div>
				</section>

				<section class="photo-all" aria-label="All media" data-reveal>
					<header class="photo-all-head">
						<h2 class="proj-duo-title">All Work</h2>
						{kindCounts.length > 1 ? (
							<div class="media-filters" role="group" aria-label="Filter by type">
								<button type="button" class="media-filter" data-media-filter="all" aria-pressed="true">
									All <span>{all.length}</span>
								</button>
								{kindCounts.map((k) => (
									<button type="button" class="media-filter" data-media-filter={k.kind} aria-pressed="false">
										{k.label} <span>{k.count}</span>
									</button>
								))}
							</div>
						) : (
							<span class="topic-count">
								{all.length} post{all.length === 1 ? '' : 's'}
							</span>
						)}
					</header>
					<div class="photo-all-masonry" data-media-grid>
						{all.map((post) => {
							const cover = resolveMediaCover(post);
							if (!cover) return null;
							return (
								<a
									class="photo-all-tile"
									href={`/media/${post.id}/`}
									aria-label={`${post.data.title} (${kindLabels[post.data.kind]})`}
									data-kind={post.data.kind}
								>
									<Image
										src={cover}
										alt={post.data.title}
										widths={[400, 700, 1000]}
										sizes="(max-width: 480px) 100vw, (max-width: 800px) 50vw, 25vw"
										loading="lazy"
									/>
									{post.data.kind === 'video' ? (
										<span class="photo-all-play" aria-hidden="true">
											<svg viewBox="0 0 24 24" width="18" height="18">
												<path d="M8 5v14l11-7z" fill="currentColor" />
											</svg>
										</span>
									) : null}
								</a>
							);
						})}
					</div>
				</section>
			</>
		)
	}
</BaseLayout>
