---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { site } from '../../site';
import { mediaKinds } from '../../utils/media-kinds';
import { kindLabels, resolveMediaGallery } from '../../utils/media-assets';
import { entryIsPublic } from '../../utils/content-visibility';
import { sortProjectsByRecency } from '../../utils/sort-projects';
import MediaCard from '../../components/MediaCard.astro';

const all = sortProjectsByRecency(await getCollection('media', entryIsPublic));
const recent = all.slice(0, 8);

/** One tile per image across every post, newest post first, each linking to its photo on the post page. */
const tiles = all.flatMap((post) =>
	resolveMediaGallery(post).map((g, i) => ({
		post,
		img: g.img,
		alt: g.alt ?? post.data.title,
		href: `/media/${post.id}/${i > 0 ? `#photo-${i + 1}` : ''}`,
		ar: g.img.width / g.img.height,
		/* Video posts mark their first tile with a play badge. */
		play: post.data.kind === 'video' && i === 0,
	})),
);

/** Tile widths at each breakpoint's row height (see `.media-wall`), with room for rows to stretch. */
function tileSizes(ar: number) {
	const w = (rowH: number) => Math.ceil(ar * rowH * 1.5);
	return `(max-width: 560px) ${w(120)}px, (max-width: 900px) ${w(180)}px, ${w(240)}px`;
}

/** Filter chips for kinds that have at least one tile. */
const kindCounts = mediaKinds
	.map((kind) => ({ kind, label: kindLabels[kind], count: tiles.filter((t) => t.post.data.kind === kind).length }))
	.filter((k) => k.count > 0);
---

<BaseLayout title={`Media — ${site.name}`} description="Photography, graphic design, and video.">
	<header class="blog-hero">
		<p class="section-label">{site.mediaIntro}</p>
		<h1>Media</h1>
		<p>Photography, graphic design, and video.</p>
	</header>

	{
		all.length === 0 ? (
			<div class="photo-index">
				<p class="work-empty">
					No media posts yet. Add one from <a class="link-accent" href="/admin/">/admin</a>, or add a folder
					under <code class="work-empty-code">src/content/media/&lt;slug&gt;/</code> with{' '}
					<code class="work-empty-code">index.mdx</code> and its files beside it.
				</p>
			</div>
		) : (
			<>
				<section class="media-section" aria-label="Recent media" data-reveal>
					<h2 class="proj-duo-title">Recent</h2>
					<div class="photo-home-grid media-post-grid">
						{recent.map((post) => (
							<MediaCard post={post} />
						))}
					</div>
				</section>

				<section class="photo-all" aria-label="All media" data-reveal>
					<header class="photo-all-head">
						<h2 class="proj-duo-title">All Work</h2>
						{kindCounts.length > 1 ? (
							<div class="media-filters" role="group" aria-label="Filter by type">
								<button type="button" class="media-filter" data-media-filter="all" aria-pressed="true">
									All <span>{tiles.length}</span>
								</button>
								{kindCounts.map((k) => (
									<button type="button" class="media-filter" data-media-filter={k.kind} aria-pressed="false">
										{k.label} <span>{k.count}</span>
									</button>
								))}
							</div>
						) : (
							<span class="topic-count">
								{tiles.length} image{tiles.length === 1 ? '' : 's'}
							</span>
						)}
					</header>
					<div class="media-wall" data-media-grid>
						{tiles.map((t) => (
							<a
								class="media-wall-tile"
								href={t.href}
								aria-label={`${t.post.data.title} (${kindLabels[t.post.data.kind]})`}
								data-kind={t.post.data.kind}
								style={`--ar: ${t.ar.toFixed(4)}`}
							>
								<Image
									src={t.img}
									alt={t.alt}
									widths={[400, 800, 1200, 1600]}
									sizes={tileSizes(t.ar)}
									loading="lazy"
								/>
								{t.play ? (
									<span class="photo-all-play" aria-hidden="true">
										<svg viewBox="0 0 24 24" width="18" height="18">
											<path d="M8 5v14l11-7z" fill="currentColor" />
										</svg>
									</span>
								) : null}
							</a>
						))}
					</div>
				</section>
			</>
		)
	}
</BaseLayout>
