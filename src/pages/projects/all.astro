---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { site } from '../../site';
import { resolveProjectThumbnail } from '../../utils/project-thumbnails';
import { entryIsPublic } from '../../utils/content-visibility';
import { sortProjectsByRecency } from '../../utils/sort-projects';
import Pin from '../../components/Pin.astro';

const projects = sortProjectsByRecency(await getCollection('projects', entryIsPublic));

function formatDate(d: Date | undefined) {
	if (!d) return '—';
	return d.toLocaleDateString('en-GB', { year: 'numeric', month: 'short', day: 'numeric' });
}
---

<BaseLayout title={`All projects — ${site.name}`} description="Every project, sorted by date.">
	<header class="blog-hero">
		<p class="section-label">{site.projectsIntro}</p>
		<h1>All Projects</h1>
		<p>{projects.length} project{projects.length === 1 ? '' : 's'}, newest first.</p>
		<div class="section-cta-wrap blog-hero-cta">
			<a class="section-cta section-cta--back" href="/projects" aria-label="Back to projects">
				<span class="section-cta-arrow section-cta-arrow--back" aria-hidden="true">
					<svg width="14" height="14" viewBox="0 0 14 14" fill="none">
						<path
							d="M12 2L2 12M2 12H10M2 12V4"
							stroke="currentColor"
							stroke-width="1.5"
							stroke-linecap="round"
							stroke-linejoin="round"
						/>
					</svg>
				</span>
				<span class="section-cta-text">Back</span>
			</a>
		</div>
	</header>

	<div class="post-list">
		{
			projects.length ? (
				projects.map((project) => {
					const thumb = resolveProjectThumbnail(project.id, project.data.thumbnail);
					return (
						<a
							href={`/projects/${project.id}/`}
							class:list={['post-row', thumb && 'post-row--has-thumb']}
						>
							<time
								class="post-date"
								datetime={project.data.pubDate?.toISOString()}
							>
								{formatDate(project.data.pubDate)}
							</time>
							{thumb ? (
								<div class="post-thumb">
									<img
										src={thumb.src}
										alt={`${project.data.title} — thumbnail`}
										width={thumb.width}
										height={thumb.height}
										loading="lazy"
										decoding="async"
									/>
								</div>
							) : null}
							<div class="post-row-main">
								<h2>
									{project.data.title}
									<Pin pinned={project.data.pin === true} />
								</h2>
								{project.data.description ? <p>{project.data.description}</p> : null}
								{project.data.tags?.length ? (
									<div class="proj-card-tags post-row-tags">
										{project.data.tags.map((t) => (
											<span class="tag">{t}</span>
										))}
									</div>
								) : null}
							</div>
						</a>
					);
				})
			) : (
				<p class="work-empty">
					No projects found. Add a folder under{' '}
					<code class="work-empty-code">src/content/projects/&lt;slug&gt;/</code> with{' '}
					<code class="work-empty-code">index.md</code> or <code class="work-empty-code">index.mdx</code>.
				</p>
			)
		}
	</div>
</BaseLayout>
