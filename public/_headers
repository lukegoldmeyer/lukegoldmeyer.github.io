# Cloudflare Pages response headers (ignored by other hosts).

# Build output in /_astro has content hashes in its filenames, so it can be cached forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Keep the CMS out of search engines and out of other sites' frames.
/admin/*
  X-Robots-Tag: noindex
  X-Frame-Options: DENY
